baseURL = 'http://localhost:1313/'
languageCode = 'zh-cn'
title = 'Chaogeek'
theme = 'PaperMod'

hasCJKLanguage = true

[params]
  env = 'production'

  ShowReadingTime = true
  ShowCodeCopyButtons = true
  ShowToc = true
  TocOpen = false
  ShowBreadCrumbs = true
  ShowPostNavLinks = true

  [params.homeInfoParams]
    Title = '你好，我是 Chaogeek 👋'
    Content = '一个 Java 程序员，正在向软件底层、安全与 AI 深入。'

[menu]

  [[menu.main]]
    identifier = 'posts'
    name = '文章'
    url = '/posts/'
    weight = 10

  [[menu.main]]
    identifier = 'archives'
    name = '归档'
    url = '/archives/'
    weight = 20